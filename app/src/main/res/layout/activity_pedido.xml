<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/lp_fondo">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="16dp" android:background="@color/lp_blanco"><androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnVolver" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" app:srcCompat="@drawable/lp_ic_volver" android:contentDescription="Volver" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Preparar pedido" android:textColor="@color/lp_texto" android:textSize="24sp" android:textStyle="bold" /></LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Revisa tus datos. WhatsApp abrirá el mensaje para que tú lo envíes. No se cobra desde esta app." android:textSize="15sp" android:textColor="@color/lp_texto" />
<EditText android:id="@+id/txtNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Nombre de quien solicita" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="textPersonName" android:maxLength="80" />
<EditText android:id="@+id/txtTelefono" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Teléfono de contacto" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="phone" android:maxLength="20" />
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Forma de entrega" android:textSize="15sp" android:textColor="@color/lp_texto" />
<Spinner android:id="@+id/spEntrega" android:layout_width="match_parent" android:layout_height="56dp" /><EditText android:id="@+id/txtDomicilio" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Domicilio para solicitar envío" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="textPostalAddress" android:maxLength="200" />
<EditText android:id="@+id/txtNotas" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Notas (opcional)" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="textMultiLine" android:maxLength="300" />
<TextView android:id="@+id/lblNegocio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Número de la tienda" android:textSize="15sp" android:textColor="@color/lp_texto" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnConfigurar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_categoria" app:backgroundTint="@null" android:text="Configurar WhatsApp de la tienda" android:textAllCaps="false" android:textColor="@color/lp_texto" />
<TextView android:id="@+id/lblResumen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Resumen" android:textSize="16sp" android:textColor="@color/lp_texto" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnWhatsApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_rojo" app:backgroundTint="@null" android:text="Revisar y abrir WhatsApp" android:textAllCaps="false" android:textColor="@color/lp_blanco" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCopiar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_categoria" app:backgroundTint="@null" android:text="Copiar resumen" android:textAllCaps="false" android:textColor="@color/lp_texto" />
</LinearLayout></ScrollView>
</LinearLayout>
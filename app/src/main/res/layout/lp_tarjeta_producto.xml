<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/lp_bg_tarjeta">

    <!-- Imagen y botón de favoritos -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="140dp">

        <ImageView
            android:id="@+id/imgProducto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:src="@drawable/lp_llanta_1"
            android:scaleType="fitCenter"
            android:contentDescription="@string/lp_texto_1" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFavorito"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:padding="13dp"
            android:background="@drawable/lp_bg_tarjeta"
            app:srcCompat="@drawable/lp_ic_favorito"
            app:tint="@color/lp_gris"
            android:contentDescription="@string/lp_agregar_favorito" />

    </FrameLayout>

    <!-- Marca y modelo -->
    <TextView
        android:id="@+id/lblNombreProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minLines="2"
        android:text="@string/lp_texto_3"
        android:textColor="@color/lp_texto"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Medida -->
    <TextView
        android:id="@+id/lblMedidaProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/lp_texto_4"
        android:textColor="@color/lp_gris"
        android:textSize="13sp" />

    <!-- Precio -->
    <TextView
        android:id="@+id/lblPrecioProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/lp_texto_5"
        android:textColor="@color/lp_rojo"
        android:textSize="20sp"
        android:textStyle="bold" />

<TextView android:id="@+id/lblOferta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Oferta" android:textSize="11sp" android:textColor="@color/lp_texto" />
    <!-- Agregar al carrito -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAgregarCarrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:minWidth="0dp"
        android:layout_marginTop="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/lp_bg_rojo"
        app:backgroundTint="@null"
        android:text="@string/lp_texto_6"
        android:textAllCaps="false"
        android:textColor="@color/lp_blanco"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
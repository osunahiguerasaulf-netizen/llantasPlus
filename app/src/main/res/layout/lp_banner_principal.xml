<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="220dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="18dp"
    android:background="@drawable/lp_bg_banner_principal">

    <!-- Textos y botón -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lp_banner_titulo"
            android:textColor="@color/lp_blanco"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/lp_banner_descripcion"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVerProductos"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/lp_bg_rojo"
            app:backgroundTint="@null"
            android:text="@string/lp_banner_boton"
            android:textAllCaps="false"
            android:textColor="@color/lp_blanco"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Imagen independiente del fondo -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:src="@drawable/lp_llantas_banner"
        android:scaleType="fitCenter"
        android:contentDescription="@string/lp_banner_imagen" />

</LinearLayout>
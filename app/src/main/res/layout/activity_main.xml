<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login">

        <!-- Decoraciones del fondo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/decoracion_login"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="52dp"
                android:paddingBottom="52dp">

                <!-- Logo principal -->
                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:src="@mipmap/llantasplus_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_name" />

                <!-- Bienvenida -->
                <TextView
                    android:id="@+id/lblBienvenido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/bienvenido"
                    android:textAlignment="center"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/subtitulo_login"
                    android:textAlignment="center"
                    android:textColor="@color/texto_gris"
                    android:textSize="16sp" />

                <!-- Usuario o correo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="48dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_usuario"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/txtUsuario"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_usuario"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_gris"
                        android:textSize="16sp"
                        android:padding="0dp"
                        android:importantForAutofill="yes"
                        android:autofillHints="username" />
                </LinearLayout>

                <!-- Contraseña -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_candado"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/txtPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword" android:saveEnabled="false"
                        android:singleLine="true"
                        android:textColor="@color/texto_oscuro"
                        android:textColorHint="@color/texto_gris"
                        android:textSize="16sp"
                        android:padding="0dp"
                        android:importantForAutofill="yes"
                        android:autofillHints="password" />

                    <ImageButton
                        android:id="@+id/btnVerPassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_ojo"
                        android:padding="12dp"
                        android:contentDescription="@string/ver_password" />
                </LinearLayout>

                <!-- Recuperar contraseña -->
                <TextView
                    android:id="@+id/lblRecuperar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="end|center_vertical"
                    android:text="@string/recuperar_password"
                    android:textColor="@color/rojo_principal"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Iniciar sesión -->

                <!-- Registrarse -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnIngresar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_boton_principal"
                    app:backgroundTint="@null"
                    android:text="@string/iniciar_sesion"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:elevation="3dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRegistrar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_boton_registro"
                    app:backgroundTint="@null"
                    android:text="@string/registrarse"
                    android:textAllCaps="false"
                    android:textColor="@color/rojo_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Salir -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSalir"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_boton_salir"
                    app:backgroundTint="@null"
                    android:text="@string/salir"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_gris"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
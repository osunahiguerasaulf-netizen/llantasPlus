<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/lp_fondo">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="16dp" android:background="@color/lp_blanco"><androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnVolver" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" app:srcCompat="@drawable/lp_ic_volver" android:contentDescription="Volver" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mi perfil" android:textColor="@color/lp_texto" android:textSize="24sp" android:textStyle="bold" /></LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/lblUsuario" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Mi cuenta" android:textSize="22sp" android:textColor="@color/lp_texto" />
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Perfil local: se conserva en este teléfono. El historial muestra solicitudes preparadas, no confirma recepción ni pago." android:textSize="15sp" android:textColor="@color/lp_texto" />
<EditText android:id="@+id/txtNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Nombre para pedidos" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="textPersonName" android:maxLength="80" />
<EditText android:id="@+id/txtTelefono" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Teléfono de contacto" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="phone" android:maxLength="20" />
<EditText android:id="@+id/txtDomicilio" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Domicilio (opcional)" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="textPostalAddress" android:maxLength="200" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_rojo" app:backgroundTint="@null" android:text="Guardar datos" android:textAllCaps="false" android:textColor="@color/lp_blanco" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnFavoritos" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_categoria" app:backgroundTint="@null" android:text="Mis favoritos" android:textAllCaps="false" android:textColor="@color/lp_texto" />
<TextView android:id="@+id/lblTituloPedidos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Solicitudes preparadas" android:textSize="20sp" android:textColor="@color/lp_texto" />
<LinearLayout android:id="@+id/contenedorPedidos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCerrarSesion" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_categoria" app:backgroundTint="@null" android:text="Cerrar sesión" android:textAllCaps="false" android:textColor="@color/lp_texto" />
</LinearLayout></ScrollView>
<LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:background="@color/lp_blanco"><TextView android:id="@+id/navInicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="8dp" android:drawableTop="@drawable/lp_ic_inicio" android:drawableTint="@color/lp_gris" android:drawablePadding="5dp" android:text="Inicio" android:textSize="11sp" android:textColor="@color/lp_gris" android:clickable="true" android:focusable="true" /><TextView android:id="@+id/navCatalogo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="8dp" android:drawableTop="@drawable/lp_ic_catalogo" android:drawableTint="@color/lp_gris" android:drawablePadding="5dp" android:text="Catálogo" android:textSize="11sp" android:textColor="@color/lp_gris" android:clickable="true" android:focusable="true" /><TextView android:id="@+id/navCarrito" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="8dp" android:drawableTop="@drawable/lp_ic_carrito" android:drawableTint="@color/lp_gris" android:drawablePadding="5dp" android:text="Carrito" android:textSize="11sp" android:textColor="@color/lp_gris" android:clickable="true" android:focusable="true" /><TextView android:id="@+id/navPerfil" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="8dp" android:drawableTop="@drawable/lp_ic_perfil" android:drawableTint="@color/lp_rojo" android:drawablePadding="5dp" android:text="Perfil" android:textSize="11sp" android:textColor="@color/lp_rojo" android:clickable="true" android:focusable="true" /></LinearLayout></LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lp_fondo"
    >

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:background="@color/lp_blanco">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/lp_logo"
            android:scaleType="fitStart"
            android:contentDescription="@string/lp_texto_13" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNotificaciones"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/lp_ic_campana"
            app:tint="@color/lp_texto"
            android:contentDescription="@string/lp_texto_14" />

    </LinearLayout>

    <!-- Contenido desplazable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Catálogo de demostración · disponibilidad y precios finales por WhatsApp" android:textSize="12sp" android:textColor="@color/lp_texto" />
            <!-- Buscador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:background="@drawable/lp_bg_busqueda">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/lp_ic_buscar"
                    android:contentDescription="@string/lp_texto_25" />

                <EditText
                    android:id="@+id/txtBuscar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="@string/lp_texto_26"
                    android:textColor="@color/lp_texto"
                    android:textColorHint="@color/lp_gris"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch" />

            </LinearLayout>

            <!-- Banner principal -->
            <include
                android:id="@+id/bannerPrincipal"
                layout="@layout/lp_banner_principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp" />

            <!-- Categorías con imágenes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Todas -->
                <LinearLayout
                    android:id="@+id/categoriaTodas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="104dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/lp_bg_seleccion"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:src="@drawable/lp_llantas_banner"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/lp_texto_18"
                        android:textColor="@color/lp_rojo"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Automóvil -->
                <LinearLayout
                    android:id="@+id/categoriaAuto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="104dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/lp_bg_categoria"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:src="@drawable/lp_categoria_auto"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/lp_texto_20"
                        android:textColor="@color/lp_texto"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- SUV -->
                <LinearLayout
                    android:id="@+id/categoriaSuv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="104dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/lp_bg_categoria"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:src="@drawable/lp_categoria_suv"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/lp_texto_22"
                        android:textColor="@color/lp_texto"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Camioneta -->
                <LinearLayout
                    android:id="@+id/categoriaCamioneta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="104dp"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp"
                    android:background="@drawable/lp_bg_categoria"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:src="@drawable/lp_categoria_camioneta"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/lp_texto_24"
                        android:textColor="@color/lp_texto"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>
            <!-- Encabezado de destacados -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lp_texto_27"
                    android:textColor="@color/lp_texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnVerTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:text="@string/lp_texto_28"
                    android:textColor="@color/lp_rojo"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Dos tarjetas de ejemplo -->

            <!-- Encabezado de ofertas -->
            <LinearLayout
                android:id="@+id/contenedorDestacados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tarjetaProducto1"
                    layout="@layout/lp_tarjeta_producto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tarjetaProducto2"
                    layout="@layout/lp_tarjeta_producto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lp_texto_29"
                    android:textColor="@color/lp_texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnVerTodasOfertas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:text="@string/lp_texto_30"
                    android:textColor="@color/lp_rojo"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Banner de ofertas -->
            <include
                android:id="@+id/bannerOfertas"
                layout="@layout/lp_banner_ofertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Separador de la navegación -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lp_borde" />

    <!-- Navegación inferior fija -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/lp_blanco">

        <TextView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:drawableTop="@drawable/lp_ic_inicio"
            android:drawableTint="@color/lp_rojo"
            android:drawablePadding="5dp"
            android:text="@string/lp_texto_33"
            android:textColor="@color/lp_rojo"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navCatalogo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:drawableTop="@drawable/lp_ic_catalogo"
            android:drawableTint="@color/lp_gris"
            android:drawablePadding="5dp"
            android:text="@string/lp_texto_35"
            android:textColor="@color/lp_gris"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navCarrito"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:drawableTop="@drawable/lp_ic_carrito"
            android:drawableTint="@color/lp_gris"
            android:drawablePadding="5dp"
            android:text="@string/lp_texto_37"
            android:textColor="@color/lp_gris"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:drawableTop="@drawable/lp_ic_perfil"
            android:drawableTint="@color/lp_gris"
            android:drawablePadding="5dp"
            android:text="@string/lp_texto_39"
            android:textColor="@color/lp_gris"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
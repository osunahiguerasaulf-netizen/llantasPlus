<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/lp_fondo">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="16dp" android:background="@color/lp_blanco"><androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnVolver" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" app:srcCompat="@drawable/lp_ic_volver" android:contentDescription="Volver" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Crear cuenta" android:textColor="@color/lp_texto" android:textSize="24sp" android:textStyle="bold" /></LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tu cuenta y tus favoritos se guardan en este dispositivo. No se envían contraseñas por WhatsApp." android:textSize="15sp" android:textColor="@color/lp_texto" />
<EditText android:id="@+id/txtNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Nombre completo" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="textPersonName" android:maxLength="80" />
<EditText android:id="@+id/txtUsuario" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Usuario (sin espacios)" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="text" android:maxLength="30" />
<EditText android:id="@+id/txtCorreo" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Correo electrónico" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="textEmailAddress" android:maxLength="120" />
<EditText android:id="@+id/txtPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Contraseña (mínimo 8 caracteres)" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="textPassword" android:saveEnabled="false" android:maxLength="128" />
<EditText android:id="@+id/txtConfirmar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/lp_bg_busqueda" android:hint="Confirmar contraseña" android:textColor="@color/lp_texto" android:textColorHint="@color/lp_gris" android:inputType="textPassword" android:saveEnabled="false" android:maxLength="128" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_rojo" app:backgroundTint="@null" android:text="Crear cuenta" android:textAllCaps="false" android:textColor="@color/lp_blanco" />
</LinearLayout></ScrollView>
</LinearLayout>
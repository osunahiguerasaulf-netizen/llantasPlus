<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/lp_fondo">
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="16dp" android:background="@color/lp_blanco"><androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnVolver" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless" app:srcCompat="@drawable/lp_ic_volver" android:contentDescription="Volver" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mi carrito" android:textColor="@color/lp_texto" android:textSize="24sp" android:textStyle="bold" /></LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/lblVacio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Todavía no agregas llantas. Explora el catálogo para comenzar." android:textSize="15sp" android:textColor="@color/lp_texto" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCatalogo" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_categoria" app:backgroundTint="@null" android:text="Seguir comprando" android:textAllCaps="false" android:textColor="@color/lp_texto" />
<LinearLayout android:id="@+id/contenedorCarrito" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /><TextView android:id="@+id/lblTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Total estimado" android:textSize="24sp" android:textColor="@color/lp_texto" />
<TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Precios de demostración. Existencias, envío, instalación y total final se confirman con la tienda." android:textSize="15sp" android:textColor="@color/lp_texto" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPedir" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_rojo" app:backgroundTint="@null" android:text="Preparar pedido por WhatsApp" android:textAllCaps="false" android:textColor="@color/lp_blanco" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btnVaciar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/lp_bg_categoria" app:backgroundTint="@null" android:text="Vaciar carrito" android:textAllCaps="false" android:textColor="@color/lp_texto" />
</LinearLayout></ScrollView>
<LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:background="@color/lp_blanco"><TextView android:id="@+id/navInicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="8dp" android:drawableTop="@drawable/lp_ic_inicio" android:drawableTint="@color/lp_gris" android:drawablePadding="5dp" android:text="Inicio" android:textSize="11sp" android:textColor="@color/lp_gris" android:clickable="true" android:focusable="true" /><TextView android:id="@+id/navCatalogo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="8dp" android:drawableTop="@drawable/lp_ic_catalogo" android:drawableTint="@color/lp_gris" android:drawablePadding="5dp" android:text="Catálogo" android:textSize="11sp" android:textColor="@color/lp_gris" android:clickable="true" android:focusable="true" /><TextView android:id="@+id/navCarrito" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="8dp" android:drawableTop="@drawable/lp_ic_carrito" android:drawableTint="@color/lp_rojo" android:drawablePadding="5dp" android:text="Carrito" android:textSize="11sp" android:textColor="@color/lp_rojo" android:clickable="true" android:focusable="true" /><TextView android:id="@+id/navPerfil" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="8dp" android:drawableTop="@drawable/lp_ic_perfil" android:drawableTint="@color/lp_gris" android:drawablePadding="5dp" android:text="Perfil" android:textSize="11sp" android:textColor="@color/lp_gris" android:clickable="true" android:focusable="true" /></LinearLayout></LinearLayout>